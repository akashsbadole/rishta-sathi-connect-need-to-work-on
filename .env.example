
# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Google Analytics
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Google Search Console
VITE_GOOGLE_SITE_VERIFICATION=your_verification_code_here

# API Endpoints
VITE_API_BASE_URL=http://localhost:3001/api
VITE_CONTACT_FORM_ENDPOINT=/contact/submit

# Payment Gateways
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_here
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Security
VITE_ENCRYPTION_KEY=your_32_character_encryption_key_here

# Feature Flags
VITE_ENABLE_AI_MATCHING=true
VITE_ENABLE_BACKGROUND_VERIFICATION=true
VITE_ENABLE_WEDDING_SERVICES=true
